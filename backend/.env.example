# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Google AI Studio ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# ── Gemini models (defaults shown — change only if you want a different model) ─
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
GENERATION_MODEL=gemini-3.5-flash-lite
# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=ai_ds_book

# ── RAG behaviour ─────────────────────────────────────────────────────────────
RAG_TOP_K=5
# Minimum cosine similarity [0.0–1.0] for a chunk to count as evidence.
# Raise to require stronger matches; lower to be more permissive.
RAG_SCORE_THRESHOLD=0.65

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
